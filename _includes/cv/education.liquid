{% comment %}
  LOCAL OVERRIDE of al_folio_cv's templates/cv/education.liquid.
  Gem data handling kept verbatim; only the presentation changes to the
  single full-width column with an inline date badge (matches cv/experience.liquid).
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-12 date-column">
          {% comment %} `capture` keeps the surrounding whitespace, so strip before testing for emptiness {% endcomment %}
          {% capture start_date %}
            {% if entry.start_date %}{{ entry.start_date }}{% elsif entry.startDate %}{{ entry.startDate }}{% endif %}
          {% endcapture %}
          {% assign start_date = start_date | strip %}
          {% capture end_date %}
            {% if entry.end_date %}{{ entry.end_date }}{% elsif entry.endDate %}{{ entry.endDate }}{% endif %}
          {% endcapture %}
          {% assign end_date = end_date | strip %}
          {% comment %}
            An entry may carry a single point-in-time `date` instead of a start/end pair. `al_cv_sort_by_date` already
            orders on it, so render it too rather than silently dropping the badge.
          {% endcomment %}
          {% capture point_date %}
            {% if entry.date %}{{ entry.date }}{% elsif entry.releaseDate %}{{ entry.releaseDate }}{% endif %}
          {% endcapture %}
          {% assign point_date = point_date | strip %}

          {% if start_date != '' %}
            {% comment %} Extract year only from dates like "1933-01-01" or just use "1933" as is {% endcomment %}
            {% assign startDate = start_date | split: '-' | slice: 0, 2 | join: '.' %}
            {% assign endDate = end_date | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
            {% assign date = startDate | append: ' - ' | append: endDate %}
          {% elsif point_date != '' %}
            {% comment %} A standalone date is a point in time, never an open-ended range, so it renders as a single year {% endcomment %}
            {% assign date = point_date | split: '-' | slice: 0, 2 | join: '.' %}
          {% else %}
            {% assign date = null %}
          {% endif %}

          {% capture study_type %}
            {% if entry.studyType %}{{ entry.studyType }}{% elsif entry.degree %}{{ entry.degree }}{% endif %}
          {% endcapture %}

          <div class="cv-entry-head">
            <div class="cv-entry-title">
              {% if entry.url %}
                <h6 class="title font-weight-bold">
                  <a href="{{ entry.url }}">{{ study_type }}</a>
                </h6>
              {% elsif study_type != '' %}
                <h6 class="title font-weight-bold">{{ study_type }}</h6>
              {% endif %}
            </div>
            {% if date %}
              <span class="cv-date-badge">{{ date }}</span>
            {% endif %}
          </div>

          {% capture location %}
            {% if entry.location %}{{ entry.location }}{% endif %}
          {% endcapture %}
          {% assign location = location | strip %}
          {% if entry.institution or location != '' %}
            <div class="cv-entry-meta">
              {% if entry.institution %}
                <h6 style="font-size: 0.95rem">{{ entry.institution }}</h6>
              {% endif %}
              {% if location != '' %}
                <p class="location">
                  <i class="fa-solid fa-location-dot iconlocation"></i>
                  {{ location }}
                </p>
              {% endif %}
            </div>
          {% endif %}

          {% if entry.area %}
            <h6 class="cv-entry-summary" style="font-size: 0.95rem; font-style: italic">{{ entry.area }}</h6>
          {% endif %}

          {% if entry.courses or entry.highlights %}
            <ul class="items">
              {% for item in entry.courses %}
                <li>
                  <span class="item">{{ item }}</span>
                </li>
              {% endfor %}
              {% for item in entry.highlights %}
                <li>
                  <span class="item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>

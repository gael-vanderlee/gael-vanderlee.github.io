{% comment %}
  LOCAL OVERRIDE of al_folio_cv's templates/cv/experience.liquid.

  Keeps the gem's data handling verbatim (RenderCV + JSONResume field aliases,
  point-in-time dates, markdownify, null-safety) and only changes the presentation:
  a single full-width column with the title and date badge on one line and the
  employer + location on the next, instead of the gem's 2/10 date-column split.
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-12 date-column">
          {% capture start_date %}
            {% if entry.start_date %}{{ entry.start_date }}{% elsif entry.startDate %}{{ entry.startDate }}{% endif %}
          {% endcapture %}
          {% assign start_date = start_date | strip %}
          {% capture end_date %}
            {% if entry.end_date %}{{ entry.end_date }}{% elsif entry.endDate %}{{ entry.endDate }}{% endif %}
          {% endcapture %}
          {% assign end_date = end_date | strip %}
          {% capture point_date %}
            {% if entry.date %}{{ entry.date }}{% elsif entry.releaseDate %}{{ entry.releaseDate }}{% endif %}
          {% endcapture %}
          {% assign point_date = point_date | strip %}

          {% if start_date != '' %}
            {% assign startDate = start_date | split: '-' | slice: 0, 2 | join: '.' %}
            {% assign endDate = end_date | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
            {% assign date = startDate | append: ' - ' | append: endDate %}
          {% elsif point_date != '' %}
            {% assign date = point_date | split: '-' | slice: 0, 2 | join: '.' %}
          {% else %}
            {% assign date = null %}
          {% endif %}

          {% capture position_title %}
            {% if entry.position %}{{ entry.position }}{% endif %}
          {% endcapture %}
          {% assign position_title = position_title | strip %}

          <div class="cv-entry-head">
            <div class="cv-entry-title">
              {% if position_title != '' %}
                {% if entry.url %}
                  <h6 class="title font-weight-bold">
                    <a href="{{ entry.url }}">{{ position_title }}</a>
                  </h6>
                {% else %}
                  <h6 class="title font-weight-bold">{{ position_title }}</h6>
                {% endif %}
              {% endif %}
            </div>
            {% if date %}
              <span class="cv-date-badge">{{ date }}</span>
            {% endif %}
          </div>

          {% capture company_name %}
            {% if entry.name %}{{ entry.name }}{% elsif entry.company %}{{ entry.company }}{% elsif entry.organization %}{{ entry.organization }}{% endif %}
          {% endcapture %}
          {% assign company_name = company_name | strip %}
          {% capture location %}
            {% if entry.location %}{{ entry.location }}{% endif %}
          {% endcapture %}
          {% assign location = location | strip %}

          {% if company_name != '' or location != '' %}
            <div class="cv-entry-meta">
              {% if company_name != '' %}
                <h6 style="font-size: 0.95rem">{{ company_name }}</h6>
              {% endif %}
              {% if location != '' %}
                <p class="location">
                  <i class="fa-solid fa-location-dot iconlocation"></i>
                  {{ location }}
                </p>
              {% endif %}
            </div>
          {% endif %}

          {% if entry.summary %}
            <h6 class="cv-entry-summary" style="font-size: 0.95rem; font-style: italic">
              {{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}
            </h6>
          {% endif %}

          {% if entry.highlights %}
            <ul class="items">
              {% for item in entry.highlights %}
                <li>
                  <span class="item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
